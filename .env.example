# ─── Secrets ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Feed Endpoints ────────────────────────────────────────────────────────────
CABLE_FAULT_FEED_URL=https://api.example-cable-tracker.io/v1
AIS_FEED_URL=https://api.example-ais-provider.io/v2
CLOUD_STATUS_AWS_URL=https://health.aws.amazon.com/public/currentevents
CLOUD_STATUS_AZURE_URL=https://status.azure.com/api/v2/status
CLOUD_STATUS_GCP_URL=https://status.cloud.google.com/incidents.json

# ─── DuckDB ────────────────────────────────────────────────────────────────────
DUCKDB_PATH=data/risk_engine.duckdb
DDL_PATH=ddl.sql

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/risk_engine.jsonl

# ─── Spatial ───────────────────────────────────────────────────────────────────
SPATIAL_JOIN_RADIUS_KM=2000
H3_RESOLUTION=3

# ─── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=4
